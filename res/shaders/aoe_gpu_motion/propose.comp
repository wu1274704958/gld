#version 430 core

// Solve-B2：Round 0 永远先提交完整的原始意向；只有它在直接依赖传播后仍未解决，
// Round 1..3 才尝试全方向 fallback。一个 invocation 负责一个单位，并逐像素检查
// 刚体 footprint。identity_wait.w=1 表示本 tick 有可执行的移动意向。
layout(local_size_x = 64) in;
layout(binding = 0, rg16ui) uniform readonly uimage2D current_image;
layout(binding = 0) uniform sampler2D field_sampler;

struct UnitData { vec4 position_radii; vec4 intent_dt; uvec4 identity_wait; };
struct Proposal { vec4 velocity_destination; uvec4 meta; };
layout(std430, binding = 0) readonly buffer Units { UnitData units[]; };
layout(std430, binding = 1) buffer Proposals { Proposal proposals[]; };
layout(std430, binding = 3) readonly buffer HandleMap { uint handle_to_index[]; };
uniform uint unit_count;
uniform vec2 map_origin;
uniform float pixels_per_world_unit;
uniform ivec2 image_size;
uniform uint candidate_round;

const float Pi = 3.14159265359;

vec2 rotate2(vec2 value, float angle) {
    float c = cos(angle), s = sin(angle);
    return vec2(c * value.x - s * value.y,
                s * value.x + c * value.y);
}

bool proposal_covers(uint index, ivec2 pixel) {
    vec2 center = (proposals[index].velocity_destination.zw - map_origin) *
                  pixels_per_world_unit;
    vec2 radii = max(units[index].position_radii.zw * pixels_per_world_unit,
                     vec2(0.5));
    vec2 q = (vec2(pixel) + vec2(0.5) - center) / radii;
    return dot(q, q) <= 1.0;
}

// Direct 只拒绝静态障碍；任何动态 owner 都先作为依赖，方向相反也不淘汰。
bool classify_direct(UnitData unit, vec2 destination, out bool dependency) {
    vec2 center = (destination - map_origin) * pixels_per_world_unit;
    vec2 radii = max(unit.position_radii.zw * pixels_per_world_unit, vec2(0.5));
    if (any(lessThan(center - radii, vec2(0.0))) ||
        any(greaterThanEqual(center + radii, vec2(image_size)))) return false;
    ivec2 lo = max(ivec2(floor(center - radii)), ivec2(0));
    ivec2 hi = min(ivec2(ceil(center + radii)), image_size - 1);
    dependency = false;
    for (int y = lo.y; y <= hi.y; ++y)
        for (int x = lo.x; x <= hi.x; ++x) {
            ivec2 pixel = ivec2(x, y);
            vec2 q = (vec2(pixel) + vec2(0.5) - center) / radii;
            if (dot(q, q) > 1.0) continue;
            uint owner = imageLoad(current_image, pixel).r;
            if (owner >= 0xF000u) return false;
            if (owner != 0u && owner != unit.identity_wait.x)
                dependency = true;
        }
    return true;
}

// Fallback 不再创建新的未解依赖。动态 owner 只有已经 accepted 且 next footprint
// 确实会离开目标像素时才可视为空位；其余候选留给下一轮或下一 fixed tick。
bool fallback_free(UnitData unit, vec2 destination) {
    vec2 center = (destination - map_origin) * pixels_per_world_unit;
    vec2 radii = max(unit.position_radii.zw * pixels_per_world_unit, vec2(0.5));
    if (any(lessThan(center - radii, vec2(0.0))) ||
        any(greaterThanEqual(center + radii, vec2(image_size)))) return false;
    ivec2 lo = max(ivec2(floor(center - radii)), ivec2(0));
    ivec2 hi = min(ivec2(ceil(center + radii)), image_size - 1);
    for (int y = lo.y; y <= hi.y; ++y)
        for (int x = lo.x; x <= hi.x; ++x) {
            ivec2 pixel = ivec2(x, y);
            vec2 q = (vec2(pixel) + vec2(0.5) - center) / radii;
            if (dot(q, q) > 1.0) continue;
            uint owner = imageLoad(current_image, pixel).r;
            if (owner == 0u || owner == unit.identity_wait.x) continue;
            if (owner >= 0xF000u) return false;
            uint blocker = handle_to_index[owner];
            if (blocker == 0xFFFFFFFFu || proposals[blocker].meta.w != 2u ||
                proposal_covers(blocker, pixel)) return false;
        }
    return true;
}

uint priority_key(UnitData unit, bool dependency) {
    // Ready 的最高位为 0，DependencyPending 为 1；随后才比较等待与稳定 handle。
    uint wait_priority = 0x7FFFu - min(unit.identity_wait.z, 0x7FFFu);
    return (dependency ? 0x80000000u : 0u) |
           (wait_priority << 16u) | unit.identity_wait.x;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= unit_count) return;
    UnitData unit = units[i];
    float speed = length(unit.intent_dt.xy);

    Proposal empty;
    empty.velocity_destination = vec4(0.0, 0.0, unit.position_radii.xy);
    empty.meta = uvec4(priority_key(unit, false), 0u, 0u, 0u);
    if (unit.identity_wait.w == 0u || speed <= 0.00001) {
        proposals[i] = empty;
        return;
    }

    Proposal previous = proposals[i];
    // Direct/fallback 已经 accepted 后，后续轮次不得改方向。
    if (candidate_round > 0u && previous.meta.w == 2u) return;

    vec2 intent_direction = unit.intent_dt.xy / speed;
    if (candidate_round == 0u) {
        vec2 destination = unit.position_radii.xy + unit.intent_dt.xy * unit.intent_dt.z;
        bool dependency = false;
        if (!classify_direct(unit, destination, dependency)) {
            proposals[i] = empty;
            return;
        }
        empty.velocity_destination = vec4(unit.intent_dt.xy, destination);
        empty.meta.x = priority_key(unit, dependency);
        empty.meta.z = 1u; // direction index 0 + 1
        proposals[i] = empty;
        return;
    }

    uint tried_mask = candidate_round > 1u ? previous.meta.y : 0u;
    if (candidate_round > 1u && previous.meta.z > 0u)
        tried_mask |= 1u << (previous.meta.z - 1u);

    Proposal best = empty;
    best.meta.y = tried_mask;
    float best_score = -1e20;
    // 16 个完整方向；反向没有方向惩罚。空旷时 direction 0 通过稳定 tie-break 获胜。
    for (int direction_index = 0; direction_index < 16; ++direction_index) {
        if ((tried_mask & (1u << uint(direction_index))) != 0u) continue;
        float angle = float(direction_index) * (2.0 * Pi / 16.0);
        vec2 direction = rotate2(intent_direction, angle);
        const float scales[4] = float[4](1.0, 0.75, 0.5, 0.25);
        for (int tier = 0; tier < 4; ++tier) {
            float scale = scales[tier];
            vec2 velocity = direction * speed * scale;
            vec2 destination = unit.position_radii.xy + velocity * unit.intent_dt.z;
            if (!fallback_free(unit, destination)) continue;
            ivec2 field_pixel = clamp(ivec2((destination - map_origin) *
                pixels_per_world_unit), ivec2(0), image_size - 1);
            vec4 field = texelFetch(field_sampler, field_pixel, 0);
            // 长度是主目标；拥堵与静态净空只在同一长度档中排序。
            float score = scale * 100.0 - field.z * 2.0 + field.w * 0.25 -
                          float(direction_index) * 0.0001;
            if (score > best_score) {
                best_score = score;
                best.velocity_destination = vec4(velocity, destination);
                best.meta.x = priority_key(unit, false);
                best.meta.z = uint(direction_index) + 1u;
            }
            break; // 该方向已经找到最长的立即可走长度。
        }
    }
    proposals[i] = best;
}
