#version 430 core

// Solve-B3b：每个候选 footprint 的所有像素用 imageAtomicMin 竞争。
// key 先按等待时间（越久越优先）、再按稳定 handle 排序。这里只写 scratch；
// 后续必须验证“每一个像素都获胜”，所以绝不会提交破碎的半个 footprint。
layout(local_size_x=64) in;
layout(binding=2,r32ui) uniform uimage2D reservation_image;
struct UnitData{vec4 position_radii;vec4 intent_dt;uvec4 identity_wait;};
struct Proposal{vec4 velocity_destination;uvec4 meta;};
layout(std430,binding=0)readonly buffer Units{UnitData units[];};
layout(std430,binding=1)readonly buffer Proposals{Proposal proposals[];};
uniform uint unit_count;uniform vec2 map_origin;uniform float pixels_per_world_unit;
uniform ivec2 image_size;
void main(){uint i=gl_GlobalInvocationID.x;if(i>=unit_count||proposals[i].meta.z==0u)return;
 vec2 center=(proposals[i].velocity_destination.zw-map_origin)*pixels_per_world_unit;
 vec2 radii=max(units[i].position_radii.zw*pixels_per_world_unit,vec2(0.5));
 ivec2 lo=max(ivec2(floor(center-radii)),ivec2(0));ivec2 hi=min(ivec2(ceil(center+radii)),image_size-1);
 for(int y=lo.y;y<=hi.y;++y)for(int x=lo.x;x<=hi.x;++x){vec2 q=(vec2(x,y)+vec2(.5)-center)/radii;
  if(dot(q,q)<=1.0)imageAtomicMin(reservation_image,ivec2(x,y),proposals[i].meta.x);}}
