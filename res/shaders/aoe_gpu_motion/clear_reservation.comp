#version 430 core

// Solve-B3a：清空临时 R32UI reservation image。
// 该图不是第三张世界状态图，只保存本轮原子竞争的 priority key。
layout(local_size_x=16,local_size_y=16) in;
layout(binding=2,r32ui) uniform writeonly uimage2D reservation_image;
uniform ivec2 image_size;
uniform ivec2 dispatch_origin;
uniform ivec2 dispatch_size;
void main(){ivec2 lp=ivec2(gl_GlobalInvocationID.xy);
 if(any(greaterThanEqual(lp,dispatch_size)))return;
 ivec2 p=dispatch_origin+lp;
 if(any(greaterThanEqual(p,image_size)))return;
 imageStore(reservation_image,p,uvec4(0xFFFFFFFFu));}
